---
import SectionHeader from "./SectionHeader.astro";
import { talks, type TalkLink } from "../data/talks";

const linkLabel: Record<TalkLink["kind"], string> = {
  paper: "Paper",
  youtube: "Video",
  slides: "Slides",
};
---

<section id="talks" class="section-block">
  <SectionHeader title="Invited Talks">
    <svg
      slot="icon"
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="#FF0000"
      aria-hidden="true"
      style="position: relative; top: 4px;"
    >
      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.016 3.016 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136C4.495 20.455 12 20.455 12 20.455s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
    </svg>
  </SectionHeader>

  <ul class="mt-2 space-y-1.5">
    {
      talks.map((t) => (
        <li class="text-[0.93rem]" style="color: var(--fg);">
          <span
            class="mr-2 italic"
            style="color: var(--fg-3); font-family: ui-monospace, Menlo, monospace; font-size: 0.82rem;"
          >
            {t.date}
          </span>
          <strong style="color: var(--fg);">{t.title}</strong>
          <span style="color: var(--fg-2);">
            {" — "}
            {t.venueHref ? (
              <a href={t.venueHref}>{t.venue}</a>
            ) : (
              t.venue
            )}
          </span>
          {t.links && t.links.length > 0 && (
            <span class="ml-1.5 inline-flex flex-wrap items-baseline gap-x-1.5">
              {t.links.map((l) => (
                <a
                  href={l.href}
                  class="bracket-link text-[0.85rem]"
                  target="_blank"
                  rel="noreferrer noopener"
                >
                  {linkLabel[l.kind]}
                </a>
              ))}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</section>
