---
interface Props {
  /** Lead sentence — supports HTML (e.g. <strong>11</strong> for inline numbers). */
  lead?: string;
}

const { lead } = Astro.props;
---

{
  lead && (
    <p
      class="mt-1 text-[0.92rem]"
      style="color: var(--fg-2); line-height: 1.5;"
      set:html={lead}
    />
  )
}
