---
import SectionHeader from "./SectionHeader.astro";
import { experience, education, type ExperienceItem } from "../data/experience";

const columns: { title: string; entries: ExperienceItem[] }[] = [
  { title: "Experience", entries: [...experience] },
  { title: "Education", entries: [...education] },
];
---

<section id="experience" class="section-block">
  <SectionHeader title="Experience & Education">
    <svg
      slot="icon"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="#0a66c2"
      aria-hidden="true"
      style="position: relative; top: 5px;"
    >
      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
    </svg>
  </SectionHeader>

  <div class="mt-3 grid grid-cols-1 gap-x-10 gap-y-8 lg:grid-cols-2 lg:gap-x-12">
    {
      columns.map((col) => (
        <div>
          <h4
            class="mb-2 text-[0.78rem] font-bold uppercase"
            style="color: var(--accent); letter-spacing: 0.08em;"
          >
            {col.title}
          </h4>
          <ol class="timeline">
            {col.entries.map((e) => (
              <li class="timeline-entry">
                <div class="flex items-start gap-x-3">
                  <div class="flex h-12 w-[110px] flex-shrink-0 items-center justify-center">
                    <img
                      src={e.logo}
                      alt=""
                      style="max-height: 48px; max-width: 100%; object-fit: contain;"
                    />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div
                      class="text-[0.92rem]"
                      style="line-height: 1.25; font-weight: 700; color: var(--fg);"
                    >
                      {e.role}
                    </div>
                    <div class="mt-0.5 text-[0.84rem]" style="color: var(--fg-2);">
                      {e.orgHref ? <a href={e.orgHref}>{e.org}</a> : e.org}
                      {e.location && (
                        <span style="color: var(--fg-3);"> · {e.location}</span>
                      )}
                    </div>
                    <div
                      class="mt-0.5 text-[0.74rem]"
                      style="color: var(--fg-3); font-family: ui-monospace, Menlo, monospace; letter-spacing: 0.02em;"
                    >
                      {e.period}
                    </div>
                    {e.advisorLinks && e.advisorLinks.length > 0 && (
                      <div
                        class="mt-1 text-[0.8rem]"
                        style="color: var(--fg-3);"
                      >
                        {e.advisorLinks.length === 1 ? "Supervisor" : "Advisors"}:{" "}
                        {e.advisorLinks.map((a, ai) => (
                          <>
                            {ai > 0 && ", "}
                            <a href={a.href}>{a.name}</a>
                          </>
                        ))}
                      </div>
                    )}
                    {e.bullets && e.bullets.length > 0 ? (
                      <ul
                        class="mt-1.5 space-y-1 text-[0.84rem]"
                        style="color: var(--fg-2); line-height: 1.45;"
                      >
                        {e.bullets.map((b) => (
                          <li class="relative pl-3.5">
                            <span
                              aria-hidden="true"
                              style="position: absolute; left: 0; top: 0.55em; width: 4px; height: 4px; background: var(--accent); border-radius: 1px;"
                            />
                            <span set:html={b} />
                          </li>
                        ))}
                      </ul>
                    ) : (
                      e.description && (
                        <p
                          class="mt-1 text-[0.84rem]"
                          style="color: var(--fg-2); line-height: 1.45;"
                        >
                          {e.description}
                        </p>
                      )
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>
