---
interface Props {
  emoji?: string;
  title: string;
}

const { emoji, title } = Astro.props;
const hasIconSlot = Astro.slots.has("icon");
---

<h2 class="flex items-baseline gap-2.5 text-[1.4rem] lg:text-[1.45rem]">
  {hasIconSlot ? <slot name="icon" /> : emoji && <span aria-hidden="true">{emoji}</span>}
  <span>{title}</span>
</h2>
