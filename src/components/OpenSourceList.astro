---
import SectionHeader from "./SectionHeader.astro";
import Icon from "./icons/Icon.astro";
import { openSource } from "../data/openSource";
---

<section id="open-source" class="section-block">
  <SectionHeader title="Open Source">
    <svg
      slot="icon"
      width="28"
      height="28"
      viewBox="0 0 16 16"
      fill="currentColor"
      aria-hidden="true"
      style="color: var(--fg); position: relative; top: 4px;"
    >
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    </svg>
  </SectionHeader>

  <ul class="mt-2">
    {
      openSource.map((tool, i) => (
        <li
          style={i > 0 ? "border-top: 1px solid var(--rule-2);" : ""}
          class="py-1"
        >
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <a
              href={tool.href}
              class="inline-flex items-center gap-1.5 text-[0.88rem] font-semibold"
              style="color: var(--fg);"
              target="_blank"
              rel="noreferrer noopener"
            >
              {tool.name === "Auden" && (
                <img
                  src="images/auden-logo.png"
                  alt=""
                  style="width: 16px; height: 16px; border-radius: 3px;"
                />
              )}
              {tool.name}
            </a>
            <span class="inline-flex items-center gap-1">
              <a
                href={tool.href}
                class="link-icon link-icon-sm"
                aria-label={`${tool.name} on GitHub`}
                target="_blank"
                rel="noreferrer noopener"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 16 16"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                </svg>
              </a>
              {tool.hf && (
                <a
                  href={tool.hf}
                  class="link-icon link-icon-sm"
                  aria-label={`${tool.name} on Hugging Face`}
                  target="_blank"
                  rel="noreferrer noopener"
                >
                  <span
                    aria-hidden="true"
                    style="font-size: 13px; line-height: 1;"
                  >🤗</span>
                </a>
              )}
            </span>
            {(() => {
              const isPrimary =
                tool.role.includes("Founder") ||
                tool.role.includes("Creator");
              return (
                <span class="text-[0.74rem]" style="color: var(--fg-3);">
                  {tool.years} ·{" "}
                  <span
                    style={
                      isPrimary
                        ? "color: var(--highlight); font-weight: 700;"
                        : ""
                    }
                  >
                    {tool.role}
                  </span>
                </span>
              );
            })()}
          </div>
          <p
            class="text-[0.76rem]"
            style="color: var(--fg-3); line-height: 1.35; margin-top: 1px;"
          >
            {tool.blurb}
          </p>
        </li>
      ))
    }
  </ul>
</section>
