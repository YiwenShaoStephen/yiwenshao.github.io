---
import SectionHeader from "./SectionHeader.astro";
import SectionLead from "./SectionLead.astro";
import WorkRow from "./WorkRow.astro";
import type { WorkGroup } from "../data/works";

interface Props {
  id: string;
  emoji?: string;
  title: string;
  lead?: string;
  groups: WorkGroup[];
  legend?: string;
}

const { id, emoji, title, lead, groups, legend } = Astro.props;
const showGroupTitles = groups.length > 1;
---

<section id={id} class="section-block">
  <SectionHeader emoji={emoji} title={title}>
    <slot name="icon" slot="icon" />
  </SectionHeader>
  <SectionLead lead={lead} />

  {
    legend && (
      <p
        class="mt-1 text-[0.76rem]"
        style="color: var(--fg-3);"
        set:html={legend}
      />
    )
  }

  <div class="mt-2">
    {
      groups.map((g, gi) => (
        <details
          class="group-block"
          open
          style={
            gi > 0
              ? "border-top: 1px solid var(--rule); margin-top: 1.25rem; padding-top: 1rem;"
              : ""
          }
        >
          {showGroupTitles ? (
            <summary class="mb-2 flex items-center gap-2">
              <svg
                class="disclosure-chevron"
                width="10"
                height="10"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M9 5 L17 12 L9 19 Z" />
              </svg>
              <h4
                class="text-[0.9rem] font-bold uppercase"
                style="color: var(--accent); letter-spacing: 0.06em; line-height: 1; margin: 0;"
              >
                {g.title}
              </h4>
              <span
                class="text-[0.72rem]"
                style="color: var(--fg-3); font-family: ui-monospace, Menlo, monospace; letter-spacing: 0.04em;"
              >
                ({g.works.length})
              </span>
            </summary>
          ) : null}
          <div>
            {g.works.map((w, i) => (
              <div
                style={i > 0 ? "border-top: 1px solid var(--rule-2);" : ""}
              >
                <WorkRow work={w} />
              </div>
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>
