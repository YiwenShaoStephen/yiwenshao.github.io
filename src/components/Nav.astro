---
import Icon from "./icons/Icon.astro";
import { site } from "../data/site";

const links = [
  { href: "#about", label: "About" },
  { href: "#open-source", label: "Open Source" },
  { href: "#works", label: "Works" },
  { href: "#publications", label: "Publications" },
  { href: "#talks", label: "Talks" },
  { href: "#experience", label: "Experience" },
];
---

<header
  class="sticky top-0 z-30 backdrop-blur-md"
  style="background: color-mix(in oklab, var(--bg) 88%, transparent); border-bottom: 1px solid var(--rule);"
>
  <div
    class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-6 py-4"
  >
    <a
      href="#about"
      class="flex items-baseline gap-2"
      style="font-family: var(--font-display); font-size: 1.05rem; letter-spacing: -0.01em; background-image: none;"
    >
      <span style="color: var(--fg);">Yiwen Shao</span>
      <span class="hidden sm:inline" style="color: var(--fg-3); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em;">
        / 邵依文
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} class="nav-link">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-theme-toggle
        class="rounded-full p-2 transition-colors"
        style="border: 1px solid var(--rule); color: var(--fg-2);"
        aria-label="Toggle dark mode"
      >
        <span class="block dark:hidden">
          <Icon name="moon" />
        </span>
        <span class="hidden dark:block">
          <Icon name="sun" />
        </span>
      </button>
    </div>
  </div>
</header>
