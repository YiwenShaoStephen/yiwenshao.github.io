---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "en" } = Astro.props;

const L =
  lang === "zh"
    ? {
        aria: "示意图：组织熵随四个阶段与三次重组的变化曲线",
        yAxis: "组织熵 ↑",
        xAxis: "→ 时间",
        stages: [
          ["AI Lab 1.0", "小作坊"],
          ["大模型 1.0", "大融合"],
          ["AI Lab 2.0", "内部重建"],
          ["大模型 2.0", "换血重塑"],
        ],
        caption:
          "fig. 1 — 一条从 AI Lab 到 Frontier Lab 的进化线：每次 reorg 都是一次熵的尖峰，问题是之后能不能降得更低",
      }
    : {
        aria: "Diagram: organizational entropy across four stages and three reorgs",
        yAxis: "org entropy ↑",
        xAxis: "→ time",
        stages: [
          ["AI Lab 1.0", "boutique"],
          ["LLM 1.0", "merger"],
          ["AI Lab 2.0", "rebuild"],
          ["LLM 2.0", "transplant"],
        ],
        caption:
          "fig. 1 — one evolution from AI Lab to Frontier Lab: every reorg spikes the entropy; the question is whether it settles lower afterwards",
      };
const xs = [127, 302, 477, 652];
---

<div class="post-fig" role="img" aria-label={L.aria}>
  <svg viewBox="0 0 760 252" xmlns="http://www.w3.org/2000/svg">
    {[30, 72, 115, 158, 200].map((y) => (
      <line class="gridline" x1="40" y1={y} x2="740" y2={y}></line>
    ))}

    {[215, 390, 565].map((x) => (
      <line class="reorg-line" x1={x} y1="30" x2={x} y2="200"></line>
    ))}
    {[220, 395, 570].map((x) => (
      <text class="reorg-label" x={x} y="42">reorg</text>
    ))}

    <text class="axis-label" x="40" y="20">{L.yAxis}</text>
    <text class="axis-label" x="740" y="222" text-anchor="end">{L.xAxis}</text>

    <path
      class="curve"
      d="M 40,60 L 65,68 L 90,58 L 115,72 L 140,66 L 165,78 L 190,70 L 215,82
         L 219,46
         L 245,80 L 270,95 L 295,88 L 320,108 L 345,100 L 365,84 L 390,72
         L 394,44
         L 420,90 L 445,105 L 470,118 L 495,112 L 520,128 L 540,124 L 565,116
         L 569,62
         L 595,110 L 620,138 L 645,152 L 670,166 L 695,172 L 720,178 L 740,182"
    ></path>

    <circle class="ckpt" cx="215" cy="82" r="4.5"></circle>
    <circle class="ckpt" cx="390" cy="72" r="4.5"></circle>
    <circle class="ckpt" cx="565" cy="116" r="4.5"></circle>
    <circle class="ckpt" cx="740" cy="182" r="4.5"></circle>

    {L.stages.map(([label, sub], i) => (
      <>
        <text class="stage-label" x={xs[i]} y="228" text-anchor="middle">{label}</text>
        <text class="stage-sub" x={xs[i]} y="244" text-anchor="middle">{sub}</text>
      </>
    ))}
  </svg>
  <div class="caption">{L.caption}</div>
</div>
