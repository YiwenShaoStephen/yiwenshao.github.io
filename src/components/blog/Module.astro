---
interface Props {
  code: string;
  claim: string;
}
const { code, claim } = Astro.props;
---

<div class="post-module">
  <span class="code">{code}</span>
  <span class="claim">{claim}</span>
  <div class="post-verdict no">
    <span class="mark">✗</span>
    <div><slot name="wrong" /></div>
  </div>
  <div class="post-verdict ok">
    <span class="mark">✓</span>
    <div><slot name="right" /></div>
  </div>
</div>
