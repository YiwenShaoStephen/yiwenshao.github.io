---
import Icon from "./icons/Icon.astro";
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = [
  { id: "about", label: "About" },
  { id: "news", label: "News" },
  { id: "blog", label: "Blog" },
  { id: "oss", label: "Open source" },
  { id: "talks", label: "Talks" },
  { id: "experience", label: "Experience" },
];
---

<aside class="side">
  <h1 class="side-name">
    Yiwen Shao
    <span class="cn">邵依文</span>
  </h1>

  <p class="side-role">
    {site.role} @ <a href={site.affiliation.href}>{site.affiliation.name}</a> —
    building <strong>full-duplex multimodal LLMs</strong>.
  </p>

  <a
    class="logo-chip side-logo"
    href={site.affiliation.href}
    aria-label={site.affiliation.name}
  >
    <img src={`${base}/images/nuancelabs-logo.png`} alt={site.affiliation.name} />
  </a>

  <ul class="side-links">
    {
      site.social.map((s) => (
        <li>
          <a class="plain-link" href={s.href} aria-label={s.label}>
            <Icon name={s.kind} />
            <span>{s.label}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <nav class="side-nav" aria-label="Sections">
    {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
    <a href={`${base}/publications/`} class="out">Publications →</a>
  </nav>
</aside>
