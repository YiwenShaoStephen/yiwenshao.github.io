---
import { site } from "../data/site";
import GithubActivity from "./GithubActivity.astro";
---

<section class="sec about" id="about">
  <div class="sec-eyebrow">ABOUT</div>

  <p>
    I'm currently a {site.role} at <a href={site.affiliation.href}>{site.affiliation.name}</a>,
    building <strong>full-duplex multimodal LLMs</strong>.
  </p>

  <p>
    Previously Senior Researcher at <a
      href="https://ailab.tencent.com/ailab/en/index/">Tencent AI Lab &amp; Hunyuan</a>
    (Bellevue) under <a
      href="https://scholar.google.com/citations?user=tMY31_gAAAAJ">Dong Yu (俞栋)</a> —
    led <strong>audio-language pretraining</strong> and <strong>representation
    learning</strong>, founded <a
      class="ecosystem-badge"
      href="https://github.com/AudenAI/Auden"><img src="images/auden-logo.png" alt="" /><span
      >Auden</span></a>, key contributor to the initial launch of Hunyuan
    Speech 1.0, and led audio pretraining for Hunyuan Speech 3.0.
  </p>

  <p>
    Ph.D. from <a href="https://www.clsp.jhu.edu/">JHU CLSP</a>, advised by <a
      href="https://danielpovey.com/">Daniel Povey</a> and <a
      href="https://www.clsp.jhu.edu/people/sanjeev-khudanpur/">Sanjeev
    Khudanpur</a> — focused on ASR and audio understanding.
  </p>

  <div class="topics">
    {site.topics.map((t) => <span>{t}</span>)}
  </div>

  <GithubActivity />
</section>
